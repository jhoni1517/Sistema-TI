{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cobranca",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/nota",
      "schedule": "0 13 * * *"
    }
  ]
}
